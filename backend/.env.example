MA_ENVIRONMENT=development
MA_DATABASE_URL=postgresql://ma_m1:YOUR_LOCAL_PASSWORD@127.0.0.1:55434/ma_m1
MA_ALLOW_SIMULATED_DATA=true
# Optional local public education rehearsal; must remain false in production.
MA_DEMO_MEDICAL_EDUCATION=false
MA_COOKIE_SECURE=false
MA_CUSTOMER_LOGIN_REQUIRED=true
MA_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:5175","http://127.0.0.1:8001"]
# Seed command requires M1_SEED_PASSWORD (not stored here); development only.
MA_NEO4J_URI=bolt://127.0.0.1:57689
MA_NEO4J_USER=neo4j
MA_NEO4J_PASSWORD=YOUR_ISOLATED_LOCAL_GRAPH_PASSWORD
MA_NEO4J_DATABASE=neo4j
MA_MILVUS_URI=http://127.0.0.1:59531
MA_MILVUS_COLLECTION=ma_knowledge_256
# Distinct limited accounts; scripts/milvus_config.py generates local secrets.
MA_MILVUS_READ_TOKEN=ma_reader:YOUR_LOCAL_READ_PASSWORD
MA_MILVUS_WRITE_TOKEN=ma_worker:YOUR_LOCAL_WRITE_PASSWORD
# Offline provisioning only; API/worker never use the root token.
MA_MILVUS_ADMIN_TOKEN=root:YOUR_LOCAL_ADMIN_PASSWORD
LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-plus
# Legacy MA_MODEL_BASE_URL / MA_MODEL_API_KEY / MA_CHAT_MODEL are still supported.
# LLM_* takes precedence when present. A bare dashscope.aliyuncs.com is normalized.
MA_EMBEDDING_MODEL=text-embedding-v4
MA_MODEL_USE_ENV_PROXY=true
# Import never grants export. An authorized snapshot adds exact hashes separately.
# SHA-256 of exact title + newline + content; only explicitly authorized texts belong here.
MA_MODEL_EXPORT_HASHES=[]

# Booking data keys must persist across restarts; keep out of Git and back up securely.
# Generate encryption key using cryptography.fernet.Fernet.generate_key().
MA_BOOKING_ENCRYPTION_KEY=
MA_BOOKING_HMAC_KEY=
# Development may explicitly select simulated when MA_ALLOW_SIMULATED_DATA=true.
# Production requires aliyun + real approved sign/template + credentials, never simulated/disabled.
MA_BOOKING_SMS_PROVIDER=disabled
MA_BOOKING_POLICY_KEY=faq-online-application
MA_SMS_ACCESS_KEY_ID=
MA_SMS_ACCESS_KEY_SECRET=
MA_SMS_SIGN_NAME=
MA_SMS_TEMPLATE_CODE=

# AI marketing: dedicated opt-in keys; never falls back to LLM_API_KEY.
MA_MARKETING_IMAGE_API_KEY=
MA_MARKETING_VIDEO_API_KEY=
MA_MARKETING_VIDEO_ENABLED=false
MA_MARKETING_VIDEO_MODEL=wan3.0-video
# Beijing workspace ID, not its display name or a full URL; required for Wan 3.0.
MA_MARKETING_VIDEO_WORKSPACE_ID=
MA_MARKETING_DAILY_LIMIT=10
# Relative to backend/ locally; shared named volume at /app/runtime/marketing in Docker.
MA_MARKETING_MEDIA_ROOT=runtime/marketing
MA_MARKETING_MAX_ASSET_MB=24
# Asset downloads accept HTTPS and these public provider CDN suffixes only.
MA_MARKETING_ASSET_HOSTS=["aliyuncs.com","siliconflow.cn","siliconflow.com","siliconflow.net","scdn.cn"]
